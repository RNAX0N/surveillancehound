# SurveillanceHound — always-running monitor.
#
# Install:
#   sudo cp deploy/hound.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now hound
#
# Logs:
#   journalctl -u hound -f
#
# This unit assumes:
#   * `hound` is on PATH at /usr/local/bin/hound (pip install -e . in a
#     system venv, OR cp the venv shim to /usr/local/bin, OR adjust ExecStart).
#   * The config lives at /etc/hound.toml.
#   * SQLite + logs live under StateDirectory/LogsDirectory (managed by
#     systemd; you don't have to create them).
#   * tcpdump is on PATH. We grant the unit CAP_NET_RAW + CAP_NET_ADMIN
#     instead of running as root — tcpdump only needs those two caps.

[Unit]
Description=SurveillanceHound — NVR / IP-camera network monitor
Documentation=https://github.com/RNAX0N/surveillancehound
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/hound run /etc/hound.toml
Restart=always
RestartSec=5s

# Drop privileges. CAP_NET_RAW + CAP_NET_ADMIN are what tcpdump needs to
# capture packets; AmbientCapabilities gives them to child processes too.
# Alternative: keep User=root and remove these — simpler, less isolated.
DynamicUser=yes
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN

# State + logs (systemd creates and chowns these to the dynamic UID)
StateDirectory=surveillancehound
LogsDirectory=surveillancehound
ConfigurationDirectory=surveillancehound
RuntimeDirectory=surveillancehound

# Hardening — block access to anything we don't need
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
PrivateTmp=yes
# tcpdump needs /dev/bpf* on BSD; harmless on Linux. On its own line:
# systemd has NO trailing comments, so `PrivateDevices=no  # ...` failed
# to parse and was IGNORED, logging
#   Failed to parse PrivateDevices=no ... ignoring: Invalid argument
# on every single start. Harmless here only because `no` is already the
# default — written as `yes` it would have silently not hardened
# anything, which is the same class of defect as a config key that does
# nothing. Found on a real Debian 13 host.
PrivateDevices=no
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# Allow network syscalls (tcpdump needs them); block raw filesystem mounts etc.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @mount @debug @cpu-emulation @obsolete
# Re-allow exactly the privilege-drop family, which the line above denies
# as part of @privileged.
#
# Debian's tcpdump is built --with-user=tcpdump and drops privileges to
# that account on startup. Under the deny line those setuid/setgid calls
# are killed by seccomp with SIGSYS, which produces NO stderr at all —
# so the daemon reported only "tcpdump did not produce a valid pcap
# stream (leading bytes b'')" and the service restart-looped. Verified on
# a real Debian 13 NVR: with the deny line alone tcpdump exits 255 and
# writes nothing; with this line it captures normally.
#
# Not a hole worth worrying about: the unit already runs as a
# DynamicUser with only CAP_NET_RAW and CAP_NET_ADMIN, so there is no
# privileged uid for these calls to reach. tcpdump is merely dropping to
# an even less privileged account than the one it started in.
SystemCallFilter=setuid setgid setgroups setresuid setresgid

# Resource bounds — defensive, not aggressive
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=multi-user.target
