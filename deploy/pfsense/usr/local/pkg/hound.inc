<?php
/*
 * SurveillanceHound — pfSense package include.
 *
 * Generates /usr/local/etc/hound.toml from the form values stored in
 * config.xml under installedpackages/hound, installs the rc.d service
 * script, and starts/stops the daemon on enable/disable.
 *
 * Called from hound.xml via the custom_php_* hooks. The pfSense package
 * runtime guarantees `config.inc` and `util.inc` are loaded by the time
 * we get here, so $config[] is in scope.
 */

require_once("util.inc");
require_once("services.inc");

function hound_install_command() {
    // make sure state + log dirs exist
    @mkdir("/var/lib/hound", 0755, true);
    @mkdir("/var/log/hound", 0755, true);
    @mkdir("/usr/local/etc", 0755, true);
    chown("/var/lib/hound", "nobody");
    chgrp("/var/lib/hound", "nobody");
    chown("/var/log/hound", "nobody");
    chgrp("/var/log/hound", "nobody");

    // rc.d wrapper — pfSense looks under /usr/local/etc/rc.d for service files
    $rc = <<<'EOF'
#!/bin/sh
# PROVIDE: hound
# REQUIRE: NETWORKING SERVERS
# KEYWORD: shutdown
. /etc/rc.subr
name=hound
rcvar=hound_enable
load_rc_config $name
: ${hound_enable:=YES}
pidfile=/var/run/${name}.pid
command=/usr/sbin/daemon
command_args="-c -P ${pidfile} -o /var/log/hound/hound.log -- \
    /usr/local/bin/hound run /usr/local/etc/hound.toml"
required_files=/usr/local/etc/hound.toml
run_rc_command "$1"
EOF;
    file_put_contents("/usr/local/etc/rc.d/hound.sh", $rc);
    chmod("/usr/local/etc/rc.d/hound.sh", 0755);

    hound_resync_config();
}

function hound_deinstall_command() {
    mwexec("/usr/local/etc/rc.d/hound.sh onestop");
    @unlink("/usr/local/etc/rc.d/hound.sh");
    // leave /var/lib/hound and /var/log/hound — operator may want history
}

function hound_resync_config() {
    global $config;
    $s = $config['installedpackages']['hound']['config'][0] ?? [];

    $listen_iface = $s['interface'] ?? '';
    // pfSense stores interfaces as "wan", "lan", "opt1" — resolve to the
    // real device the kernel knows about
    if ($listen_iface && function_exists('get_real_interface')) {
        $listen_iface = get_real_interface($listen_iface);
    }

    $enabled = isset($s['enabled']) && $s['enabled'] === 'on';
    $bp_enabled = isset($s['baseline_enabled']) && $s['baseline_enabled'] === 'on';
    $sn_enabled = isset($s['snapshot_enabled']) && $s['snapshot_enabled'] === 'on';
    $web_enabled = isset($s['web_enabled']) && $s['web_enabled'] === 'on';

    $toml = hound_render_toml(
        $listen_iface,
        $s['bpf']                    ?? '',
        intval($s['snaplen']         ?? 96),
        $s['camera_ips']             ?? '',
        $s['camera_subnets']         ?? '',
        $s['nvr_ips']                ?? '',
        $s['manufacturer_allowlist'] ?? '',
        $bp_enabled,
        floatval($s['z_threshold']   ?? 4.0),
        intval($s['min_samples']     ?? 100),
        $sn_enabled,
        floatval($s['snapshot_window_seconds'] ?? 60.0),
        $s['snapshot_min_severity']  ?? 'medium',
        $web_enabled,
        $s['web_host']               ?? '127.0.0.1',
        intval($s['web_port']        ?? 8080),
    );
    file_put_contents("/usr/local/etc/hound.toml", $toml);

    // (re)start the service to pick up the new config
    if ($enabled) {
        mwexec("/usr/local/etc/rc.d/hound.sh onerestart");
    } else {
        mwexec("/usr/local/etc/rc.d/hound.sh onestop");
    }
}

function hound_csv_to_toml_array($csv) {
    $items = array_filter(array_map('trim', explode(',', $csv ?? '')),
                          function($x) { return $x !== ''; });
    $quoted = array_map(function($x) { return '"' . addslashes($x) . '"'; },
                        $items);
    return '[' . implode(', ', $quoted) . ']';
}

function hound_b($b) { return $b ? 'true' : 'false'; }

function hound_render_toml(
    $iface, $bpf, $snaplen,
    $camera_ips, $camera_subnets, $nvr_ips, $mfg_allow,
    $bp_enabled, $z, $min_samples,
    $sn_enabled, $sn_window, $sn_minsev,
    $web_enabled, $web_host, $web_port
) {
    // Pre-compute everything that needs a function call — PHP heredoc only
    // interpolates simple variable expressions, not function calls.
    $bpf_line = $bpf !== '' ? 'bpf       = "' . addslashes($bpf) . "\"\n" : '';
    $cams     = hound_csv_to_toml_array($camera_ips);
    $subnets  = hound_csv_to_toml_array($camera_subnets);
    $nvrs     = hound_csv_to_toml_array($nvr_ips);
    $allow    = hound_csv_to_toml_array($mfg_allow);
    $bp_b     = hound_b($bp_enabled);
    $sn_b     = hound_b($sn_enabled);
    $web_b    = hound_b($web_enabled);

    return <<<EOT
# Generated by the SurveillanceHound pfSense package — do not hand-edit.
# To add custom [[notify]] blocks, drop them into /etc/hound.toml.local
# (sourced by the rc.d script).

[capture]
interface = "{$iface}"
snaplen   = {$snaplen}
{$bpf_line}
[network]
camera_ips             = {$cams}
camera_subnets         = {$subnets}
nvr_ips                = {$nvrs}
manufacturer_allowlist = {$allow}

[store]
path = "/var/lib/hound/hound.sqlite"

[baseline]
enabled                = {$bp_b}
z_threshold            = {$z}
min_samples            = {$min_samples}
flush_interval_seconds = 60.0

[snapshot]
enabled         = {$sn_b}
window_seconds  = {$sn_window}
min_severity    = "{$sn_minsev}"
snaplen         = 1500

[web]
enabled                = {$web_b}
host                   = "{$web_host}"
port                   = {$web_port}
poll_interval_seconds  = 5.0

[[notify]]
type  = "stdout"
level = "low"

[[notify]]
type      = "jsonlines"
path      = "/var/log/hound/hound.alerts.jsonl"
level     = "low"
max_bytes = 10485760
keep      = 5
EOT;
}
