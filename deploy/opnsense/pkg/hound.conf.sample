# SurveillanceHound pkg repository.
#
# Install on the firewall as /usr/local/etc/pkg/repos/hound.conf, alongside the
# public key the catalogue is signed with:
#
#     fetch -o /usr/local/etc/pkg/repos/hound-repo.pub \
#       https://rnax0n.github.io/surveillancehound/opnsense/hound-repo.pub
#     fetch -o /usr/local/etc/pkg/repos/hound.conf \
#       https://rnax0n.github.io/surveillancehound/opnsense/hound.conf
#     pkg update
#     pkg install os-hound
#
# After that os-hound is a first-class package: `pkg upgrade` keeps it current,
# and because it registers under /usr/local/opnsense/version/ it also survives
# firmware upgrades (sync.subr.sh reinstalls configured plugins).
#
# It will also appear in System > Firmware > Plugins. Tick "Show community
# plugins" to see it before it is installed — OPNsense hides plugins that
# aren't from its own repos until they are installed or configured. Note that
# OPNsense refuses to install ANY plugin while core is behind its repo, so run
# the firmware update first if the install is rejected.
#
# ${ABI} is expanded by pkg itself, so one config works on every OPNsense
# base. 26.7 moved to FreeBSD 15, 25.x and 26.1 are FreeBSD 14, and each
# firewall fetches only the catalogue matching its own. A fixed URL here is
# how you get "pkg: wrong architecture: FreeBSD:14:amd64 instead of
# FreeBSD:15:amd64" after a major upgrade.
#
# Plain HTTP would also be fine here: the catalogue is signed, so transport
# integrity is not what protects you.
#
# Leave OPNsense's own repositories enabled. Disabling them breaks firmware
# updates.

hound: {
  url: "https://rnax0n.github.io/surveillancehound/opnsense/${ABI}",
  mirror_type: "none",
  signature_type: "pubkey",
  pubkey: "/usr/local/etc/pkg/repos/hound-repo.pub",
  enabled: yes
}
