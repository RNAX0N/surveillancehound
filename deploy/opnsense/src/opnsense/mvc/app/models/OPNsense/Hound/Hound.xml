<model>
    <mount>//OPNsense/Hound</mount>
    <description>SurveillanceHound — IP-camera network monitor</description>
    <version>0.1</version>
    <items>
        <general>
            <enabled type="BooleanField">
                <default>0</default>
                <Required>Y</Required>
            </enabled>
            <interface type="InterfaceField">
                <Required>Y</Required>
                <Multiple>N</Multiple>
            </interface>
            <bpf type="TextField">
                <Required>N</Required>
            </bpf>
            <snaplen type="IntegerField">
                <default>96</default>
                <MinimumValue>64</MinimumValue>
                <MaximumValue>65535</MaximumValue>
            </snaplen>
        </general>
        <network>
            <camera_ips type="CSVListField">
                <Required>N</Required>
                <Mask>/^((25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)(\.(25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)){3}|[0-9A-Fa-f:]+)$/u</Mask>
                <ValidationMessage>Enter IP addresses, one per entry. Hostnames are not supported - the daemon does no DNS resolution and only sees addresses on the wire. To cover a whole range use Camera subnets instead.</ValidationMessage>
            </camera_ips>
            <camera_subnets type="CSVListField">
                <Required>N</Required>
                <Mask>/^((25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)(\.(25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)){3}(\/(3[0-2]|[12]?\d))?|[0-9A-Fa-f:]+(\/(12[0-8]|1[01]\d|[1-9]?\d))?)$/u</Mask>
                <ValidationMessage>Enter CIDR ranges such as 192.168.10.0/24 (a bare address means a single host). Hostnames are not supported.</ValidationMessage>
            </camera_subnets>
            <nvr_ips type="CSVListField">
                <Required>N</Required>
                <Mask>/^((25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)(\.(25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)){3}|[0-9A-Fa-f:]+)$/u</Mask>
                <ValidationMessage>Enter IP addresses, one per entry. Hostnames are not supported.</ValidationMessage>
            </nvr_ips>
            <manufacturer_allowlist type="CSVListField">
                <Required>N</Required>
                <Mask>/^((25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)(\.(25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)){3}(\/(3[0-2]|[12]?\d))?|[0-9A-Fa-f:]+(\/(12[0-8]|1[01]\d|[1-9]?\d))?)$/u</Mask>
                <ValidationMessage>Enter CIDR ranges such as 203.0.113.0/24. Hostnames are not supported.</ValidationMessage>
            </manufacturer_allowlist>
        </network>
        <thresholds>
            <silence_seconds type="NumericField">
                <default>600.0</default>
                <Required>N</Required>
                <MinimumValue>10.0</MinimumValue>
                <MaximumValue>604800.0</MaximumValue>
                <ValidationMessage>Seconds of silence before a camera is reported offline (10 - 604800).</ValidationMessage>
            </silence_seconds>
        </thresholds>
        <uptime>
            <enabled type="BooleanField">
                <default>1</default>
                <Required>N</Required>
            </enabled>
            <startup_grace_seconds type="NumericField">
                <default>600.0</default>
                <Required>N</Required>
                <MinimumValue>0</MinimumValue>
                <MaximumValue>604800.0</MaximumValue>
                <ValidationMessage>Grace period after daemon start, in seconds (0 - 604800). 0 inherits the silence threshold.</ValidationMessage>
            </startup_grace_seconds>
            <capture_stall_seconds type="NumericField">
                <default>120.0</default>
                <Required>N</Required>
                <MinimumValue>0</MinimumValue>
                <MaximumValue>604800.0</MaximumValue>
                <ValidationMessage>Seconds with zero captured packets before capture_stalled fires (0 - 604800). 0 disables it.</ValidationMessage>
            </capture_stall_seconds>
        </uptime>
        <baseline>
            <enabled type="BooleanField">
                <default>0</default>
            </enabled>
            <z_threshold type="NumericField">
                <default>4.0</default>
                <MinimumValue>1.0</MinimumValue>
                <MaximumValue>20.0</MaximumValue>
            </z_threshold>
            <min_samples type="IntegerField">
                <default>100</default>
                <MinimumValue>5</MinimumValue>
                <MaximumValue>100000</MaximumValue>
            </min_samples>
        </baseline>
        <snapshot>
            <enabled type="BooleanField">
                <default>0</default>
            </enabled>
            <window_seconds type="NumericField">
                <default>60.0</default>
                <MinimumValue>5.0</MinimumValue>
                <MaximumValue>3600.0</MaximumValue>
            </window_seconds>
            <min_severity type="OptionField">
                <default>medium</default>
                <OptionValues>
                    <info>info</info>
                    <low>low</low>
                    <medium>medium</medium>
                    <high>high</high>
                    <critical>critical</critical>
                </OptionValues>
            </min_severity>
        </snapshot>
        <web>
            <enabled type="BooleanField">
                <default>1</default>
            </enabled>
            <host type="HostnameField">
                <default>127.0.0.1</default>
            </host>
            <port type="PortField">
                <default>8080</default>
            </port>
            <cert_file type="TextField">
                <Required>N</Required>
                <Mask>/^([\/].*|)$/u</Mask>
            </cert_file>
            <key_file type="TextField">
                <Required>N</Required>
                <Mask>/^([\/].*|)$/u</Mask>
            </key_file>
        </web>
    </items>
</model>
