#!/bin/sh
#
# SurveillanceHound — FreeBSD rc.d service script (OPNsense and stock
# FreeBSD both honor this layout). Enable via:
#
#   sysrc hound_enable=YES
#   service hound start
#
# Defaults (override in /etc/rc.conf or /etc/rc.conf.local):
#   hound_enable    = NO
#   hound_config    = /usr/local/etc/hound.toml
#   hound_user      = hound
#   hound_bin       = /usr/local/bin/hound
#   hound_grant_bpf = YES   # see "BPF access" below

# PROVIDE: hound
# REQUIRE: NETWORKING SERVERS
# BEFORE:  LOGIN
# KEYWORD: shutdown

. /etc/rc.subr

name=hound
rcvar=hound_enable

load_rc_config $name

: ${hound_enable:=NO}
: ${hound_config:=/usr/local/etc/hound.toml}
: ${hound_user:=hound}
: ${hound_bin:=/usr/local/bin/hound}
: ${hound_grant_bpf:=YES}

# The pidfile must live somewhere ${hound_user} can write. /var/run is
# root-owned 0755, so rc.subr dropping privileges turned `service hound
# start` into "daemon: ppidfile '/var/run/hound.pid': Permission denied"
# — the service could not start at all.
piddir=/var/run/${name}
pidfile=${piddir}/${name}.pid
logfile=/var/log/${name}/hound.log
command=/usr/sbin/daemon
# -r restarts the child if it exits, -R 5 throttles the retry loop.
# Without -r, daemon(8) does NOT supervise: when the capture dies the
# daemon exits non-zero and nothing brings it back, so monitoring just
# stops. (The systemd unit gets this from Restart=always/RestartSec=5s.)
command_args="-c -r -R 5 -P ${pidfile} -o ${logfile} -- ${hound_bin} run ${hound_config}"
command_interpreter=""
required_files="${hound_config}"

start_precmd=hound_prestart

# Recreate the service account if it has gone missing.
#
# Everything below assumes the `hound` user AND group exist. On a real
# firewall the group was absent while the user was not, so all three
# `install -d` calls failed with "install: unknown group hound", the
# config kept whatever ownership it had, and the daemon died on
# startup with
#
#   PermissionError: [Errno 13] Permission denied: /usr/local/etc/hound.toml
#
# which `daemon -r` then retried every 5 seconds forever. Because the
# daemon never opened the store writably it never ran the schema, so
# the dashboard's export failed on a missing table and the whole page
# rendered blank. One absent group, four layers away from the symptom.
#
# Self-healing rather than an install-time check, because the account
# can disappear AFTER installation — a firmware upgrade strips drop-in
# plugins, and OPNsense regenerates system accounts from config.xml.
hound_ensure_account() {
    pw groupshow "${hound_user}" >/dev/null 2>&1 || {
        echo "hound: group '${hound_user}' missing — creating it"
        pw groupadd "${hound_user}" || {
            echo "hound: FAILED to create group '${hound_user}'." >&2
            return 1
        }
    }
    pw usershow "${hound_user}" >/dev/null 2>&1 || {
        echo "hound: user '${hound_user}' missing — creating it"
        pw useradd "${hound_user}" -g "${hound_user}" \
            -s /usr/sbin/nologin -d /var/lib/hound \
            -c "SurveillanceHound daemon" || {
            echo "hound: FAILED to create user '${hound_user}'." >&2
            return 1
        }
    }
    # The user may predate the group (that is exactly how this broke),
    # leaving a primary GID that no longer names anything.
    pw usermod "${hound_user}" -g "${hound_user}" 2>/dev/null || true
}

# The daemon reads its own config as ${hound_user}. configd renders it
# with umask 027, and the renderer chowns it — but that chown fails
# silently when the group does not exist, which is how an unreadable
# config survived a "successful" save.
hound_fix_config_perms() {
    [ -f "${hound_config}" ] || return 0
    chown "root:${hound_user}" "${hound_config}" 2>/dev/null || true
    chmod 0640 "${hound_config}" 2>/dev/null || true
    su -m "${hound_user}" -c "test -r ${hound_config}" 2>/dev/null || \
        echo "hound: warning: ${hound_user} cannot read ${hound_config} —" \
             "the daemon will exit immediately with a permission error" >&2
}

hound_prestart() {
    hound_ensure_account || return 1
    hound_fix_config_perms
    install -d -o "${hound_user}" -g "${hound_user}" -m 0755 /var/log/${name}
    install -d -o "${hound_user}" -g "${hound_user}" -m 0755 /var/lib/hound
    install -d -o "${hound_user}" -g "${hound_user}" -m 0755 "${piddir}"
    # install -d only fixes the directories. A hound.sqlite left behind
    # root-owned by an earlier run as root crash-loops the service with
    # "attempt to write a readonly database" — and because daemon(8) -r
    # keeps restarting it, `service hound status` cheerfully reports it
    # as running. Re-own the state and log trees so that is self-healing.
    chown -R "${hound_user}:${hound_user}" /var/lib/hound /var/log/${name} \
        2>/dev/null || true
    hound_grant_bpf
}

# BPF access.
#
# FreeBSD has no capabilities(7) — the Linux answer of granting tcpdump
# CAP_NET_RAW has no equivalent here. /dev/bpf is crw------- root:wheel,
# so an unprivileged capture cannot open it and tcpdump fails with
# "You don't have permission to perform this capture on that device".
#
# The alternative is running the whole daemon as root, which is what the
# pfSense script does and what we would rather not do for a process whose
# entire job is parsing untrusted bytes off the wire. Granting group
# access to the one device it needs is the smaller privilege.
#
# This is re-applied on every start rather than written into
# /etc/devfs.rules, so it survives reboots via the service itself and
# does not fight OPNsense for ownership of the global devfs ruleset.
# Set hound_grant_bpf=NO in rc.conf to manage BPF access yourself.
hound_grant_bpf() {
    [ "${hound_grant_bpf}" = "YES" ] || return 0
    _granted=0
    for dev in /dev/bpf /dev/bpf0; do
        [ -c "${dev}" ] || continue
        chgrp "${hound_user}" "${dev}" 2>/dev/null || continue
        chmod 0660 "${dev}" 2>/dev/null || continue
        # Verify the mode we actually ended up with. Testing `-r` here
        # would be useless: start_precmd runs as root, and root's
        # access(2) succeeds on 0600 root:wheel, so the check would pass
        # even when the grant had plainly failed.
        if [ "$(stat -f '%Sg %Lp' "${dev}" 2>/dev/null)" = "${hound_user} 660" ]; then
            _granted=1
        fi
    done
    if [ "${_granted}" -ne 1 ]; then
        echo "hound: warning: could not grant ${hound_user} access to" \
             "/dev/bpf — live capture will fail with a permission error." \
             "Either set hound_grant_bpf=NO and arrange access yourself," \
             "or run the daemon as root." >&2
    fi
}

run_rc_command "$1"
