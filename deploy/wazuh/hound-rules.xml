<!--
    SurveillanceHound — Wazuh custom rules.

    Drop in:
        /var/ossec/etc/rules/local_hound_rules.xml

    Then restart Wazuh:
        systemctl restart wazuh-manager

    Assumes you've added the localfile snippet from `localfile-snippet.xml`
    so the Wazuh agent (or manager, depending on where Hound runs) is
    parsing `/var/log/hound/hound.alerts.jsonl` as JSON.

    Rule IDs use the operator-defined range 100200–100299. Renumber to
    avoid collisions if you already use that range.

    Severity mapping (Hound → Wazuh level):
        info     → 3   (informational; usually filtered)
        low      → 5   (notice)
        medium   → 8   (alert)
        high     → 11  (high; pages on-call by default)
        critical → 13  (critical; pages everyone)

    Per-kind rules layer on top (specific kind matches override the
    generic severity rule by inheriting + raising the level when the
    threat model warrants it). MITRE ATT&CK tags let SOC dashboards
    pivot Hound alerts alongside other detections.
-->
<group name="surveillancehound,nvr,camera,">

    <!-- Anchor rule: anything coming from the Hound jsonlines log -->
    <rule id="100200" level="0">
        <decoded_as>json</decoded_as>
        <field name="kind">\.+</field>
        <field name="severity">\.+</field>
        <field name="device_ip">\.+</field>
        <description>SurveillanceHound: event anchor</description>
    </rule>

    <!-- Sensor-level anchor. `capture_stalled` is the one alert kind Hound
         emits with device_ip="" — the event is about THIS SENSOR going
         blind, not about a camera. An empty value does not satisfy the
         100200 anchor's `device_ip` match, so sensor-level events get
         their own anchor and must never interpolate $(device_ip). -->
    <rule id="100206" level="0">
        <decoded_as>json</decoded_as>
        <field name="kind">^capture_stalled$</field>
        <field name="severity">\.+</field>
        <description>SurveillanceHound: sensor-level event anchor</description>
    </rule>

    <!-- Severity-only fallbacks (used when no per-kind rule matches) -->
    <rule id="100201" level="3">
        <if_sid>100200</if_sid>
        <field name="severity">^info$</field>
        <description>SurveillanceHound [info]: $(kind) on $(device_ip)</description>
    </rule>
    <rule id="100202" level="5">
        <if_sid>100200</if_sid>
        <field name="severity">^low$</field>
        <description>SurveillanceHound [low]: $(kind) on $(device_ip)</description>
    </rule>
    <rule id="100203" level="8">
        <if_sid>100200</if_sid>
        <field name="severity">^medium$</field>
        <description>SurveillanceHound [medium]: $(kind) on $(device_ip)</description>
    </rule>
    <rule id="100204" level="11">
        <if_sid>100200</if_sid>
        <field name="severity">^high$</field>
        <description>SurveillanceHound [high]: $(kind) on $(device_ip)</description>
    </rule>
    <rule id="100205" level="13">
        <if_sid>100200</if_sid>
        <field name="severity">^critical$</field>
        <description>SurveillanceHound [CRITICAL]: $(kind) on $(device_ip)</description>
    </rule>

    <!-- Per-kind specific rules. MITRE ATT&CK tags help SIEM dashboards -->

    <rule id="100210" level="11">
        <if_sid>100200</if_sid>
        <field name="kind">^bulk_inbound$</field>
        <description>SurveillanceHound: bulk transfer TOWARD camera $(device_ip) — possible firmware/model push</description>
        <mitre>
            <id>T1190</id>
            <id>T1542</id>
        </mitre>
        <group>camera_manipulation,</group>
    </rule>

    <rule id="100211" level="10">
        <if_sid>100200</if_sid>
        <field name="kind">^control_channel_suspect$</field>
        <description>SurveillanceHound: camera $(device_ip) holds C2-shaped session</description>
        <mitre>
            <id>T1071</id>
            <id>T1095</id>
        </mitre>
        <group>command_and_control,</group>
    </rule>

    <rule id="100212" level="8">
        <if_sid>100200</if_sid>
        <field name="kind">^telemetry_offnet$</field>
        <description>SurveillanceHound: camera $(device_ip) telemetry to non-allowlisted host</description>
        <mitre>
            <id>T1041</id>
        </mitre>
        <group>exfiltration,</group>
    </rule>

    <rule id="100213" level="8">
        <if_sid>100200</if_sid>
        <field name="kind">^behavioral_anomaly$</field>
        <description>SurveillanceHound: behavioral anomaly on camera $(device_ip)</description>
        <mitre>
            <id>T1499</id>
        </mitre>
        <group>anomaly_detection,</group>
    </rule>

    <rule id="100214" level="5">
        <if_sid>100200</if_sid>
        <field name="kind">^new_device$</field>
        <description>SurveillanceHound: new device on segment — $(device_ip)</description>
        <mitre>
            <id>T1078</id>
        </mitre>
        <group>discovery,</group>
    </rule>

    <rule id="100215" level="5">
        <if_sid>100200</if_sid>
        <field name="kind">^new_peer$</field>
        <description>SurveillanceHound: camera $(device_ip) contacted new peer</description>
        <group>discovery,</group>
    </rule>

    <rule id="100216" level="8">
        <if_sid>100200</if_sid>
        <field name="kind">^camera_offline$</field>
        <description>SurveillanceHound: camera $(device_ip) silent — possibly offline</description>
        <mitre>
            <id>T1499</id>
        </mitre>
        <group>availability,</group>
    </rule>

    <!-- Broadcast / multicast from a camera. Level 3 (informational):
         it cannot be routed off the segment, so it is not exfiltration,
         and one camera's 30-minute beacon would otherwise produce forty
         actionable-looking alerts a day. Kept as a rule rather than
         dropped because a camera that STARTS announcing itself, or one
         that stops, is worth being able to correlate. -->
    <rule id="100226" level="3">
        <if_sid>100200</if_sid>
        <field name="kind">^broadcast_beacon$</field>
        <description>SurveillanceHound: camera beaconing to broadcast/multicast (cannot leave the segment)</description>
        <mitre>
            <id>T1046</id>
        </mitre>
        <group>discovery,</group>
    </rule>

    <rule id="100225" level="4">
        <if_sid>100200</if_sid>
        <field name="kind">^camera_to_camera$</field>
        <description>SurveillanceHound: camera talking directly to another camera</description>
        <mitre>
            <id>T1021</id>
        </mitre>
        <group>lateral_movement,</group>
    </rule>

    <!-- A relay sensor going quiet. Not a camera alert: the collector
         cannot see that segment at all, so its cameras are UNMONITORED
         rather than fine. Stopping the agent is also the first thing an
         intruder on the camera segment would do, hence level 10. -->
    <rule id="100223" level="10">
        <if_sid>100200</if_sid>
        <field name="kind">^sensor_offline$</field>
        <description>SurveillanceHound: relay sensor stopped reporting — its segment is unmonitored</description>
        <mitre>
            <id>T1562</id>
        </mitre>
        <group>availability,</group>
    </rule>

    <rule id="100224" level="3">
        <if_sid>100200</if_sid>
        <field name="kind">^sensor_recovered$</field>
        <description>SurveillanceHound: relay sensor is reporting again</description>
        <group>availability,</group>
    </rule>

    <rule id="100217" level="3">
        <if_sid>100200</if_sid>
        <field name="kind">^camera_recovered$</field>
        <description>SurveillanceHound: camera $(device_ip) visible again after an outage</description>
        <mitre>
            <id>T1499</id>
        </mitre>
        <group>availability,</group>
    </rule>

    <rule id="100218" level="8">
        <if_sid>100200</if_sid>
        <field name="kind">^camera_never_seen$</field>
        <description>SurveillanceHound: configured camera $(device_ip) has never been observed — down, misaddressed, or out of this sensor's view</description>
        <mitre>
            <id>T1499</id>
        </mitre>
        <group>availability,</group>
    </rule>

    <!-- The sensor itself is blind: no packets at all. Ranked above the
         per-camera availability rules because while this is active EVERY
         other Hound detection is silent, including camera_offline. -->
    <rule id="100219" level="12">
        <if_sid>100206</if_sid>
        <field name="kind">^capture_stalled$</field>
        <description>SurveillanceHound: CAPTURE STALLED — no packets observed, the monitor is blind and all detection has stopped</description>
        <mitre>
            <id>T1562.001</id>
        </mitre>
        <group>availability,sensor_health,</group>
    </rule>

    <!-- Correlation rule: repeated high-severity Hound alerts on one
         camera within 5 minutes suggests an active incident, not a
         false positive. Bump to level 13. -->
    <rule id="100220" level="13" frequency="3" timeframe="300">
        <if_matched_sid>100210</if_matched_sid>
        <same_field>device_ip</same_field>
        <description>SurveillanceHound: SUSTAINED bulk_inbound on camera $(device_ip) — 3+ events in 5 min</description>
        <mitre>
            <id>T1190</id>
        </mitre>
        <group>camera_manipulation,active_incident,</group>
    </rule>

    <rule id="100221" level="13" frequency="3" timeframe="300">
        <if_matched_sid>100211</if_matched_sid>
        <same_field>device_ip</same_field>
        <description>SurveillanceHound: SUSTAINED C2-shaped session on camera $(device_ip) — 3+ events in 5 min</description>
        <mitre>
            <id>T1071</id>
        </mitre>
        <group>command_and_control,active_incident,</group>
    </rule>

    <!-- Flapping capture: the sensor has gone blind and come back more than
         once. A single stall is a fault to fix; a repeating one usually
         means a dying NIC, a mirror/SPAN port being reconfigured under
         you, or a capture process that keeps crashing — i.e. detection
         coverage is unreliable, not merely absent.

         Timeframe is 2h deliberately: Hound's own dedup suppresses an
         identical alert for `dedup_window_seconds` (default 1800), so
         three capture_stalled notifications cannot arrive closer than
         ~30 min apart and the 5-min window used by the rules above
         would never fire. `same_location` keeps the count per log
         source, so two sensors reporting to one manager don't add up
         into a phantom flap. -->
    <rule id="100222" level="13" frequency="3" timeframe="7200">
        <if_matched_sid>100219</if_matched_sid>
        <same_location />
        <description>SurveillanceHound: capture FLAPPING — 3+ stalls in 2h, this sensor's coverage is unreliable</description>
        <mitre>
            <id>T1562.001</id>
        </mitre>
        <group>availability,sensor_health,active_incident,</group>
    </rule>

</group>
