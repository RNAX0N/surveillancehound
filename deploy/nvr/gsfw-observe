#!/usr/bin/python3
"""gsfw-observe — record and summarise the P1 observation window.

P1 loads an nftables table that cannot drop anything. Every named
counter in it corresponds to exactly one DROP that the P2/P3 lockdown
will introduce. This tool turns 24 hours of those counters into a
decision.

    gsfw-observe snapshot     # every 15 min, from a timer: one sample
    gsfw-observe summary      # at T+24h: the review, as markdown
    gsfw-observe event "..."  # note maintenance, so a flatline is read right

`snapshot` is append-only and never interprets. `summary` interprets and
never writes to the samples. Keeping them apart matters: a summary that
could rewrite its own inputs cannot be audited.

Verdicts are deliberately conservative. A counter the lockdown is MEANT
to stop reads "expected"; anything else reads "UNEXPECTED" and forces a
NO-GO, because the entire point of the window is to find the flows
nobody predicted. The tool will not return GO while any unexpected
class is non-zero, and it will not return GO on an empty sample set
either — no observation is not the same as nothing happening, which is
the mistake this project has made more than once.

Counters that must STAY permitted (per-camera NTP) are judged on
continuity rather than total, because the cameras run two different NTP
clients whose healthy packet counts differ by two orders of magnitude.
See the threshold block below.

Exit status: 0 GO, 1 NO-GO, 2 HOLD (needs the operator to confirm
something observation cannot settle on its own).
"""
from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import time

SAMPLES = "/var/log/gsfw-observe/samples.jsonl"
EVENTS = "/var/log/gsfw-observe/events.jsonl"
TABLE = ("inet", "gsfw")
CAMERAS = range(101, 113)

# --- how NTP liveness is judged, and why not by packet count ----------
#
# BusyBox 1.36.1 ntpd — what our own firmware runs — backs OFF once it is
# stably synced: MINPOLL 32s, BIGPOLL ~8.5min, MAXPOLL ~68min (ntpd.c).
# Vendor-firmware cameras poll every ~23s. So the same TOTAL is healthy
# for one and alarming for the other, and over a short window a perfectly
# healthy backed-off camera reads as zero.
#
# A total therefore cannot answer the question. CONTINUITY can, and it
# answers it the same way for both firmwares: a camera that is keeping
# time asks again before MAXPOLL elapses, whatever its poll floor. So we
# measure the longest span in which a counter PROVABLY did not move.
#
# Thresholds from the camera-firmware session, 2026-10-21. Their stated
# pass bar — "at least ~20 polls/24h, no gap longer than ~70min" — is the
# same test: 20 polls across 24h is unreachable without a gap over 70min,
# so the gap check subsumes the count check and we do not run both (two
# tests for one property double-report a single fault).
NTP_GAP_WARN_S = 70 * 60      # past MAXPOLL: ask, do not assume
NTP_GAP_FAIL_S = 2 * 3600     # their "0 packets across 2h is a real problem"

# Counters whose silence is already explained. Listed so the window does
# not stall on a known-absent camera — but these still print and still
# ask for confirmation, because "we knew about that one" is exactly how a
# real regression gets waved through.
EXPECTED_SILENT = {
    "in_ntp_112": "camera 12 is not deployed yet; chrony was opened for "
                  "it in P0 so that it works when it arrives.",
}

# How each counter is judged. Per-camera counters are matched by shape,
# so adding camera 13 needs no change here.
#
#   expected_block : the lockdown is MEANT to stop this. Non-zero is the
#                    finding, not a problem.
#   must_be_used   : zero means the lockdown would cut something that
#                    works today and we would not know until we enforced.
#   unexpected     : anything else non-zero. Blocks GO — finding the
#                    unpredicted flows is the whole point of the window.
#   informational  : non-zero is fine and tells us nothing is broken.
EXPECTED_BLOCK = {
    "fwd_cam_egress":
        "a camera VLAN reaching off-segment. This is the laptop-on-a-"
        "camera-cable exposure P2 exists to close.",
    "fwd_wg_to_wg":
        "peer-to-peer across the tunnel; nothing should ever do this.",
    "fwd_wg_initiated":
        "a tunnel peer initiating a flow; cameras pull nothing.",
}


def classify(name: str) -> str:
    if name in EXPECTED_BLOCK:
        return "expected_block"
    if re.fullmatch(r"in_ntp_1\d\d", name):
        return "must_be_used"
    if re.fullmatch(r"in_wg_1\d\d", name):
        # Only meaningful once the tunnel exists; silent is correct today.
        return "informational"
    if name in ("in_admin_mgmt",):
        return "informational"
    return "unexpected"


def camera_of(name: str) -> str | None:
    m = re.search(r"_(1\d\d)$", name)
    return m.group(1) if m else None


def nft(*args: str) -> str:
    p = subprocess.run(("nft", *args), capture_output=True, text=True)
    if p.returncode != 0:
        print(f"gsfw-observe: nft failed: {p.stderr.strip()}", file=sys.stderr)
        sys.exit(2)
    return p.stdout


def read_counters() -> dict[str, dict]:
    """Named counters, by name. Parsed from `nft -j` so a format change
    breaks loudly rather than being silently mis-scraped."""
    doc = json.loads(nft("-j", "list", "table", *TABLE))
    out = {}
    for item in doc.get("nftables", []):
        c = item.get("counter")
        if c and c.get("family") == TABLE[0] and c.get("table") == TABLE[1]:
            out[c["name"]] = {"packets": c.get("packets", 0),
                              "bytes": c.get("bytes", 0),
                              "comment": c.get("comment", "")}
    return out


def read_chrony() -> dict[str, dict]:
    """What chrony itself says about each camera, keyed by VLAN.

    A firewall counter answers "did a packet arrive". It cannot say
    whether the SERVER answered, and the two blockers this tool can
    raise on a silent camera — "it is not asking" and "chrony is
    refusing it" — have opposite fixes. chrony has both facts already:
    a request count, and a Drop count.

    It also guards the tool against itself. If the counter is zero and
    chrony recorded requests in the same period, the camera is fine and
    the COUNTER RULE is wrong — a possibility a tool that only reads its
    own counters cannot entertain about itself.

    Absent or unparseable chrony is not an error. It downgrades the
    verdict to what the counters alone can support, which is where this
    tool started.
    """
    p = subprocess.run(("chronyc", "-n", "clients"),
                       capture_output=True, text=True)
    if p.returncode != 0:
        return {}
    out: dict[str, dict] = {}
    for ln in (p.stdout or "").splitlines():
        f = ln.split()
        if len(f) < 6 or not re.fullmatch(r"117\.111\.(1\d\d)\.\d+", f[0]):
            continue
        cam = f[0].split(".")[2]
        try:
            out[cam] = {"ntp": int(f[1]), "drop": int(f[2]),
                        "interval": f[3], "last_s": _chrony_age(f[5])}
        except ValueError:
            continue
    return out


def _chrony_age(tok: str) -> float | None:
    """chronyc prints an age as bare seconds, or with m/h/d."""
    if tok in ("-", ""):
        return None
    mult = {"m": 60, "h": 3600, "d": 86400}.get(tok[-1])
    try:
        return float(tok[:-1]) * mult if mult else float(tok)
    except ValueError:
        return None


def cmd_event(text: str) -> int:
    """Record a maintenance event, so a counter anomaly can be attributed.

    A camera taken down for reflashing flatlines its NTP counter. Without
    a record of WHY, the summary cannot tell that from chrony silently
    refusing it — and those have opposite responses. The window overlaps
    a firmware campaign, so this is not optional bookkeeping.

    Deliberately free text with a timestamp rather than a schema: the
    point is that a human or the camera-firmware session can append
    without agreeing a format first, and the summary quotes it verbatim
    next to the anomaly rather than parsing it.
    """
    os.makedirs(os.path.dirname(EVENTS), exist_ok=True)
    with open(EVENTS, "a", encoding="utf-8") as fh:
        fh.write(json.dumps({"ts": time.time(), "text": text}) + "\n")
    print(f"gsfw-observe: recorded event: {text}")
    return 0


def load_events() -> list[dict]:
    if not os.path.exists(EVENTS):
        return []
    out = []
    for line in open(EVENTS, encoding="utf-8"):
        line = line.strip()
        if not line:
            continue
        try:
            out.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    return sorted(out, key=lambda r: r["ts"])


def events_mentioning(events: list[dict], cam: str | None,
                      span: tuple[float, float] | None = None) -> list[dict]:
    """Events that plausibly explain an anomaly on this camera.

    Matched loosely on purpose — "C6", "camera 6", "117.111.106.2" and
    "106" should all hit. A missed match costs a false blocker, which is
    the safe direction: it asks a human instead of excusing itself.

    With `span`, also require the event to be near the anomaly in TIME.
    Without that, one "C6 down for reflash" at hour 2 would excuse a C6
    outage at hour 20 — the window runs alongside a firmware campaign, so
    every camera will eventually have an event with its name on it, and a
    name-only match would end up excusing everything exactly once the log
    is full enough to be useless.
    """
    if not cam:
        return []
    short = str(int(cam) - 100)
    pats = (cam, f"c{short}", f"camera {short}", f"cam {short}")
    hits = []
    for e in events:
        low = e["text"].lower()
        if not any(pt in low for pt in pats):
            continue
        if span is not None:
            # An event explains a silence if it lands inside it, or in the
            # half hour before it — "taking C6 down now" is written just
            # before the counter flatlines, not during.
            start, end = span
            if not (start - 1800 <= e["ts"] <= end):
                continue
        hits.append(e)
    return hits


def silence_spans(samples: list[dict], name: str
                  ) -> tuple[list[tuple[float, float]], int, int]:
    """Spans in which `name` PROVABLY did not move, plus counts of the
    intervals we cannot speak for.

    Only intervals bounded by two readings count. If the counter rose
    between two samples, at least one packet arrived in between; if it
    held, nothing arrived for that whole interval. Consecutive held
    intervals merge, so the span returned is a LOWER bound on the real
    silence — never an inflated one.

    A DECREASE means the table was replaced and the counters restarted.
    That interval is unknowable, so it ends the run rather than extending
    it, and is counted and reported: a reload that quietly shortened
    every gap would otherwise turn a NO-GO into a GO.
    """
    spans: list[tuple[float, float]] = []
    resets = unknown = 0
    run_start: float | None = None
    prev = None
    for cur in samples:
        if prev is not None:
            a = prev["counters"].get(name)
            b = cur["counters"].get(name)
            if a is None or b is None:
                unknown += 1
                stop = True
            elif b["packets"] < a["packets"]:
                resets += 1
                stop = True
            elif b["packets"] > a["packets"]:
                stop = True
            else:
                stop = False
                if run_start is None:
                    run_start = prev["ts"]
            if stop and run_start is not None:
                spans.append((run_start, prev["ts"]))
                run_start = None
        prev = cur
    if run_start is not None and prev is not None:
        spans.append((run_start, prev["ts"]))
    return spans, resets, unknown


def observed_span(samples: list[dict], name: str) -> float:
    """How long this counter has existed in the samples at all.

    Not the same as the window. Counters added mid-window — the table was
    replaced to split NTP per camera — have been watched for far less
    time than the window has run, and a verdict that does not say so
    claims 24 hours of evidence it does not have.
    """
    present = [r["ts"] for r in samples if name in r["counters"]]
    return (present[-1] - present[0]) if len(present) > 1 else 0.0


def longest_span(spans: list[tuple[float, float]]
                 ) -> tuple[float, tuple[float, float] | None]:
    if not spans:
        return 0.0, None
    best = max(spans, key=lambda s: s[1] - s[0])
    return best[1] - best[0], best


def sample_resolution(samples: list[dict]) -> float:
    """The widest gap between consecutive samples. A silence shorter than
    this cannot be seen at all, so the summary states it rather than
    implying a precision the sampling does not have."""
    if len(samples) < 2:
        return 0.0
    return max(b["ts"] - a["ts"] for a, b in zip(samples, samples[1:]))


def span_str(span: tuple[float, float] | None) -> str:
    if not span:
        return ""
    f = time.strftime("%m-%d %H:%M", time.localtime(span[0]))
    t = time.strftime("%H:%M", time.localtime(span[1]))
    return f"{f}–{t}"


def cmd_snapshot() -> int:
    os.makedirs(os.path.dirname(SAMPLES), exist_ok=True)
    row = {"ts": time.time(), "counters": read_counters(),
           "chrony": read_chrony()}
    with open(SAMPLES, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(row, sort_keys=True) + "\n")
    print(f"gsfw-observe: sampled {len(row['counters'])} counters")
    return 0


def load_samples() -> list[dict]:
    if not os.path.exists(SAMPLES):
        return []
    out = []
    for line in open(SAMPLES, encoding="utf-8"):
        line = line.strip()
        if not line:
            continue
        try:
            out.append(json.loads(line))
        except json.JSONDecodeError:
            continue          # a torn tail line; do not die on the report
    return sorted(out, key=lambda r: r["ts"])


_JOURNAL: list[str] | None = None


def journal_lines() -> list[str]:
    """The kernel log for the window, read ONCE. Every would-block class
    scans it, and re-running journalctl per class made the summary slower
    than the thing it was reporting on."""
    global _JOURNAL
    if _JOURNAL is None:
        p = subprocess.run(
            ("journalctl", "-k", "--no-pager", "-o", "cat", "--since", "-25h"),
            capture_output=True, text=True)
        _JOURNAL = (p.stdout or "").splitlines()
    return _JOURNAL


def egress_by_camera() -> dict[str, int]:
    """Cameras seen trying to leave their segment, by VLAN, from the
    cam-egress log lines.

    This is the correlation that makes a silent NTP counter actionable.
    A camera with no NTP to the NVR but plenty of egress is not idle — it
    is getting the time from somewhere else, and P2 is the change that
    would cut it off. Aggregate counters cannot pair those two facts; the
    log lines carry the source address, so they can.
    """
    out: dict[str, int] = {}
    for ln in journal_lines():
        if "gsfw-wouldblock cam-egress" not in ln:
            continue
        m = re.search(r"SRC=117\.111\.(1\d\d)\.", ln)
        if m:
            out[m.group(1)] = out.get(m.group(1), 0) + 1
    return out


def journal_examples(prefix_tag: str, limit: int = 4) -> list[str]:
    """A few real log lines per class, so the summary names actual hosts
    rather than only counts."""
    hits, seen = [], set()
    for ln in journal_lines():
        if f"gsfw-wouldblock {prefix_tag}" not in ln:
            continue
        m = re.search(r"SRC=(\S+).*?DST=(\S+)(?:.*?DPT=(\d+))?", ln)
        key = m.groups() if m else (ln[:60],)
        if key in seen:
            continue
        seen.add(key)
        if m:
            src, dst, dpt = m.group(1), m.group(2), m.group(3) or "-"
            hits.append(f"{src} -> {dst}:{dpt}")
        else:
            hits.append(ln.strip()[:70])
        if len(hits) >= limit:
            break
    return hits


LOG_TAG = {
    "fwd_cam_egress": "cam-egress", "fwd_rtsp_nonfrigate": "rtsp-not-frigate",
    "fwd_into_cam_other": "into-cam", "fwd_wg_to_wg": "wg-to-wg",
    "fwd_wg_initiated": "wg-initiated", "fwd_other": "other-forward",
    "in_cam_other": "cam-to-nvr", "in_mgmt_offlan": "mgmt-not-lan",
}


def chrony_window(samples: list[dict], cam: str | None) -> dict | None:
    """chrony's own view of this camera across the window.

    `requests` is a delta between the first and last samples that carry
    chrony data, not a total, so it covers the same period the counter
    does. A negative delta means chronyd restarted and its tallies went
    back to zero; that is reported as unknown rather than as a negative
    count, because a restart is exactly when a wrong number would be
    most convincing.
    """
    if not cam:
        return None
    rows = [(r["ts"], r["chrony"][cam]) for r in samples
            if isinstance(r.get("chrony"), dict) and cam in r["chrony"]]
    if not rows:
        return None
    (t_first, first), (t_last, last) = rows[0], rows[-1]
    req = last["ntp"] - first["ntp"]
    drop = last["drop"] - first["drop"]
    # One reading is not a delta. Reporting it as "0 requests" would
    # have chrony corroborate a silent counter on no evidence at all,
    # which is worse than having no witness.
    unknown = len(rows) < 2
    return {
        "requests": None if unknown or req < 0 else req,
        "drops": None if unknown or drop < 0 else drop,
        "restarted": not unknown and (req < 0 or drop < 0),
        "single_reading": unknown,
        # chrony readings started when the cross-check was installed,
        # which is not when the counters started. A delta covering one
        # minute cannot speak for an hour of silence, and saying so is
        # the difference between a second witness and a rubber stamp.
        "span_s": t_last - t_first,
        "last_s": last.get("last_s"),
        "interval": last.get("interval"),
        "samples": len(rows),
    }


def judge_ntp(name: str, cam: str | None, tot: int, samples: list[dict],
              events: list[dict], egress: dict[str, int],
              blockers: list[str], confirm: list[str],
              cited: list[str] | None = None) -> tuple[str, str]:
    """Verdict for one camera's NTP counter, judged on continuity.

    Returns (table cell, detail line). Appends to `blockers`/`confirm`
    in place — the caller owns the overall GO/HOLD/NO-GO decision and
    this function must not be able to reach past its own camera.
    """
    spans, resets, unknown = silence_spans(samples, name)
    gap, worst = longest_span(spans)
    mins = gap / 60.0
    obs = observed_span(samples, name) / 60.0
    detail = (f"`{name}`: {tot} polls over **{obs:.0f} min** watched, "
              f"longest proven silence **{mins:.0f} min**"
              + (f" ({span_str(worst)})" if worst else ""))
    if resets:
        detail += f", {resets} counter reset(s) not judged"
    if unknown:
        detail += f", {unknown} interval(s) before this counter existed"

    ch = chrony_window(samples, cam)
    if ch:
        bits = []
        if ch["requests"] is not None:
            bits.append(f"{ch['requests']} requests in "
                        f"{ch['span_s'] / 60:.0f} min watched")
        if ch["drops"]:
            bits.append(f"**{ch['drops']} DROPPED**")
        if ch["last_s"] is not None:
            bits.append(f"last {ch['last_s'] / 60:.0f} min ago")
        if ch["interval"] and ch["interval"] != "-":
            bits.append(f"poll 2^{ch['interval']}s")
        if ch["restarted"]:
            bits.append("chronyd restarted, deltas unusable")
        if ch["single_reading"]:
            bits.append("one reading only, no delta yet")
        if bits:
            detail += " — chrony: " + ", ".join(bits)

    why_else = ""
    if cam and egress.get(cam):
        why_else = (f" It was also logged leaving its segment "
                    f"{egress[cam]}x, so it may be getting the time "
                    f"off-segment — which is the traffic P2 cuts.")

    # chrony is the independent witness. Where it contradicts the
    # counter, the counter is the thing in doubt: chrony is the service
    # we are trying to protect, and this tool is the new code.
    if ch and ch["requests"] and tot == 0:
        blockers.append(
            f"`{name}` counted nothing, but chrony served {ch['requests']} "
            f"requests from this camera over the same period. The camera is "
            f"fine; the COUNTER is not seeing its traffic. Fix the rule "
            f"before reading any verdict out of this window — every other "
            f"silent reading here is suspect for the same reason.")
        return "**RULE WRONG — chrony saw it**", detail
    if ch and ch["drops"]:
        blockers.append(
            f"`{name}`: chrony REFUSED {ch['drops']} requests from this "
            f"camera. This is the camera-12 failure, and it is a live one: "
            f"the camera is asking and not being served. Fix the chrony "
            f"allow list; it is not a firewall problem and P2/P3 will not "
            f"change it either way.")
        return "**chrony refusing**", detail

    if tot == 0:
        # Zero is judged on the SAME clock as a gap, not on its own. A
        # counter that has existed for 46 minutes and read zero proves
        # nothing: BusyBox ntpd at MAXPOLL would not have spoken yet.
        # Blocking on that is as wrong as passing a dead camera, and it
        # is the easier mistake to make because zero looks damning.
        if gap < NTP_GAP_FAIL_S:
            confirm.append(
                f"`{name}` has read zero, but only {obs:.0f} min of it is "
                f"proven silence — short of the {NTP_GAP_FAIL_S // 60} min "
                f"needed to rule out BusyBox ntpd's ~68 min backoff. Not a "
                f"finding either way yet; let the counter run.{why_else}")
            return "no verdict yet", detail
        if name in EXPECTED_SILENT:
            confirm.append(f"`{name}` saw no NTP in {mins:.0f} min. Known: "
                           f"{EXPECTED_SILENT[name]} Confirm this is still "
                           f"true before P2/P3.{why_else}")
            return "**silent — known**", detail
        rel = events_mentioning(events, cam)
        if rel:
            confirm.append(
                f"`{name}` saw no NTP in {mins:.0f} min, and an event "
                "mentions this camera: "
                + "; ".join(f'"{e["text"]}"' for e in rel[:2])
                + f". Confirm it is back and syncing before P2/P3.{why_else}")
            if cited is not None:
                cited.append(name)
            return "**silent — maintenance?**", detail
        if (ch and ch["requests"] == 0 and not ch["restarted"]
                and ch["span_s"] >= gap):
            corroborated = (" chrony independently served it nothing in the "
                            "same period, so this is the camera, not the "
                            "counter: it is not asking the NVR for time at "
                            "all, and something else is setting its clock.")
        elif ch and ch["span_s"] < gap:
            corroborated = (f" chrony has only been read for "
                            f"{ch['span_s'] / 60:.0f} min of that span, so "
                            f"it cannot corroborate this yet.")
        elif ch:
            corroborated = ""
        else:
            corroborated = (" chrony was not readable, so this rests on the "
                            "counter alone — check `chronyc -n clients` "
                            "before acting on it.")
        blockers.append(
            f"`{name}` saw no NTP in {mins:.0f} min of proven silence. That "
            f"is past backoff — BusyBox ntpd still asks once per ~68 min."
            f"{corroborated}{why_else}")
        return "**UNEXPECTED — silent**", detail

    if gap >= NTP_GAP_FAIL_S:
        rel = events_mentioning(events, cam, worst)
        if rel:
            confirm.append(
                f"`{name}` went {mins:.0f} min without a poll "
                f"({span_str(worst)}), and an event covers that span: "
                + "; ".join(f'"{e["text"]}"' for e in rel[:2])
                + ". Confirm the camera came back and resumed syncing.")
            if cited is not None:
                cited.append(name)
            return f"**{mins:.0f}min gap — maintenance?**", detail
        blockers.append(
            f"`{name}` went {mins:.0f} min without a single poll "
            f"({span_str(worst)}) and no maintenance event covers it. "
            f"Past 2h this is not backoff; the camera stopped asking."
            f"{why_else}")
        return f"**UNEXPECTED — {mins:.0f}min gap**", detail

    if gap >= NTP_GAP_WARN_S:
        confirm.append(
            f"`{name}` went {mins:.0f} min without a poll "
            f"({span_str(worst)}), past BusyBox ntpd's ~68 min MAXPOLL but "
            f"under the 2h failure bar. Likely a slow sample landing either "
            f"side of one poll; worth a glance, not a blocker.")
        return f"{mins:.0f}min gap", detail

    return "in use", detail


def cmd_summary() -> int:
    s = load_samples()
    if not s:
        print("## P1 observation — NO DATA\n")
        print("No samples were recorded, so this window observed nothing.")
        print("**NO-GO.** An empty sample set is not evidence that nothing")
        print("happened; it is evidence that nothing was watched. Check the")
        print("timer (`systemctl status gsfw-observe.timer`) and restart the")
        print("window — do not read silence as a pass.")
        return 1

    first, last = s[0], s[-1]
    hours = (last["ts"] - first["ts"]) / 3600.0
    names = sorted(set().union(*(set(r["counters"]) for r in s)))

    print("## P1 observation window — review\n")
    print(f"- samples: **{len(s)}** over **{hours:.1f}h** "
          f"({time.strftime('%Y-%m-%d %H:%M', time.localtime(first['ts']))} "
          f"to {time.strftime('%Y-%m-%d %H:%M', time.localtime(last['ts']))})")
    print("- every counter below is a flow the lockdown WOULD HAVE DROPPED.")
    print("  Nothing was dropped during this window.\n")

    print("| class | packets | first seen | last seen | verdict |")
    print("|---|---:|---|---|---|")
    blockers, findings, confirm = [], [], []
    ntp_detail: list[str] = []
    # Confirmations that rest on a logged maintenance event,
    # as opposed to ones observation simply cannot settle.
    cited: list[str] = []
    events = load_events()
    egress = egress_by_camera()
    for n in names:
        tot = last["counters"].get(n, {}).get("packets", 0)
        firsts = next((r for r in s if r["counters"].get(n, {}).get("packets", 0)), None)
        lasts = next((r for r in reversed(s)
                      if r["counters"].get(n, {}).get("packets", 0)), None)
        fs = time.strftime("%m-%d %H:%M", time.localtime(firsts["ts"])) if firsts else "—"
        ls = time.strftime("%m-%d %H:%M", time.localtime(lasts["ts"])) if lasts else "—"
        kind = classify(n)
        cam = camera_of(n)

        if kind == "must_be_used":
            verdict, note = judge_ntp(n, cam, tot, s, events, egress,
                                      blockers, confirm, cited)
            if note:
                ntp_detail.append(note)
        elif tot == 0:
            verdict = "clear"
        elif kind == "expected_block":
            verdict = "expected"
            findings.append(f"`{n}` ({tot} pkts): {EXPECTED_BLOCK[n]}")
        elif kind == "informational":
            verdict = "informational"
        else:
            rel = events_mentioning(events, cam)
            if rel:
                verdict = "**non-zero — maintenance?**"
                cited.append(n)
                confirm.append(
                    f"`{n}` saw {tot} packets, and an event may explain it: "
                    + "; ".join(f'"{e["text"]}"' for e in rel[:2])
                    + ". Confirm this traffic is not needed before P2/P3.")
            else:
                verdict = "**UNEXPECTED**"
                blockers.append(
                    f"`{n}` saw {tot} packets. The lockdown would have "
                    f"dropped these and nobody predicted them. Resolve "
                    f"before P2.")
        print(f"| `{n}` | {tot} | {fs} | {ls} | {verdict} |")

    if ntp_detail:
        res = sample_resolution(s) / 60.0
        print("\n### Per-camera time sync (judged on continuity, not count)\n")
        print(f"Sampling resolves silences no finer than **{res:.0f} min**; "
              f"every figure below is a proven lower bound.")
        if res * 60 >= NTP_GAP_FAIL_S:
            print("\n> **Sampling is coarser than the 2h failure bar**, so a "
                  "gap at that bar cannot be told from one twice its size. "
                  "Tighten the timer before trusting a GO here.")
        print()
        for d in ntp_detail:
            print(f"- {d}")

    if events:
        print("\n### Maintenance events recorded during the window\n")
        for e in events:
            print(f"- `{time.strftime('%m-%d %H:%M', time.localtime(e['ts']))}` "
                  f"{e['text']}")

    for n in names:
        tag = LOG_TAG.get(n)
        tot = last["counters"].get(n, {}).get("packets", 0)
        if not tag or not tot:
            continue
        ex = journal_examples(tag)
        if ex:
            print(f"\n**`{n}` — who:**")
            for e in ex:
                print(f"  - `{e}`")

    print("\n### Findings the lockdown is meant to stop\n")
    print("\n".join(f"- {f}" for f in findings) or "- none")

    if blockers:
        print("\n### Blockers\n")
        print("\n".join(f"- {b}" for b in blockers))
        print("\n## NO-GO for P2")
        print("Resolve the blockers above, then re-run the window.")
        return 1

    if hours < 23.0:
        print(f"\n## NO-GO for P2 — window too short ({hours:.1f}h of 24h)")
        print("Partial observation reads as 'nothing unexpected' for the")
        print("hours it did not watch. Let it finish.")
        return 1

    if confirm:
        print("\n### Needs your confirmation\n")
        print("\n".join(f"- {c}" for c in confirm))
        # Name the actual reason. Blaming maintenance when the hold is
        # really a known-absent camera sends the operator looking at the
        # wrong thing, and a verdict that misstates its own grounds is
        # the failure this tool was rewritten to stop making.
        n = len(confirm)
        print(f"\n## HOLD for P2 — {n} reading{'s' if n > 1 else ''} "
              f"observation cannot settle")
        if cited:
            print(f"Logged maintenance explains {len(cited)} of them, so those")
            print("have an innocent reading AND a dangerous one and the")
            print("counters cannot tell them apart. An event in the log is")
            print("not by itself one of these — only one that lines up with")
            print("a reading counts, which is why this says 'explains'.")
        print("Nothing above is a finding against the lockdown. Confirm each")
        print("item, and P2 is clear to proceed on everything else.")
        return 2

    print("\n## GO for P2")
    print("Every non-zero counter is a class the lockdown is meant to stop,")
    print("and everything that must stay permitted was seen in use.")
    return 0


