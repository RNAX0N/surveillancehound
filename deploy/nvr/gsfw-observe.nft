#!/usr/sbin/nft -f
#
# P1 — OBSERVE ONLY. This ruleset cannot drop, reject or alter a single
# packet. Every chain is `policy accept` and every rule ends in `return`
# or does nothing but count.
#
# Its only job is to answer one question for 24 hours: if P2's forward
# lockdown and P3's input lockdown were enforced RIGHT NOW, what would
# they have broken? Each named counter below corresponds to exactly one
# DROP that P2/P3 will introduce. A counter that is non-zero at T+24h is
# a flow the lockdown would have killed — either expected (the laptop-on-
# a-camera-cable case, which is the point) or unexpected, in which case
# enforcing without this window would have caused an outage.
#
# EVERY COUNTED CLASS IS TWO RULES, and must stay that way.
# `limit rate` is a MATCH in nftables, not a modifier on `log`. Written
# as one rule, the counter incremented, the limit then failed, the
# `return` never ran, and the packet fell through to be counted a SECOND
# time further down — usually by `fwd_other`. Totals would have inflated
# and class attribution would have been wrong precisely under load,
# which is when this table is worth reading. (The 24h window is
# unaffected: no class came near its rate.) The enforcing table had the
# same shape with a worse consequence — see gsfw-enforce.nft.
#
# Own table, replaced atomically by name. Nothing Docker owns is named.
# See mailbox-agents/surveillancehound-nvr-hardening-PLAN_2026-10-20.md

table inet gsfw
delete table inet gsfw

table inet gsfw {
    # ---- what P2 would DROP in the forward chain -----------------------
    counter fwd_cam_egress        { comment "camera VLAN -> anywhere: the laptop-on-a-camera-cable case" }
    counter fwd_rtsp_nonfrigate   { comment "something other than Frigate pulling :554 from a camera" }
    counter fwd_into_cam_other    { comment "into a camera VLAN, not Frigate RTSP and not admin" }
    counter fwd_wg_to_wg          { comment "peer-to-peer across the tunnel" }
    counter fwd_wg_initiated      { comment "a tunnel peer initiating anything" }
    counter fwd_other             { comment "forwarded, matched no allow class: P2 default-drop" }

    # ---- what P3 would DROP in the input chain -------------------------
    # PER CAMERA, not aggregate. An aggregate NTP counter reads
    # healthy while one camera is silently denied — which is the
    # exact question asked about camera 12 and chrony. It also
    # makes a maintenance flatline attributable to one unit.
    counter in_ntp_101  { comment "camera 101: NTP from 117.111.101.2" }
    counter in_wg_101   { comment "camera 101: WireGuard underlay" }
    counter in_oth_101  { comment "camera 101: anything else at the NVR" }
    counter in_ntp_102  { comment "camera 102: NTP from 117.111.102.2" }
    counter in_wg_102   { comment "camera 102: WireGuard underlay" }
    counter in_oth_102  { comment "camera 102: anything else at the NVR" }
    counter in_ntp_103  { comment "camera 103: NTP from 117.111.103.2" }
    counter in_wg_103   { comment "camera 103: WireGuard underlay" }
    counter in_oth_103  { comment "camera 103: anything else at the NVR" }
    counter in_ntp_104  { comment "camera 104: NTP from 117.111.104.2" }
    counter in_wg_104   { comment "camera 104: WireGuard underlay" }
    counter in_oth_104  { comment "camera 104: anything else at the NVR" }
    counter in_ntp_105  { comment "camera 105: NTP from 117.111.105.2" }
    counter in_wg_105   { comment "camera 105: WireGuard underlay" }
    counter in_oth_105  { comment "camera 105: anything else at the NVR" }
    counter in_ntp_106  { comment "camera 106: NTP from 117.111.106.2" }
    counter in_wg_106   { comment "camera 106: WireGuard underlay" }
    counter in_oth_106  { comment "camera 106: anything else at the NVR" }
    counter in_ntp_107  { comment "camera 107: NTP from 117.111.107.2" }
    counter in_wg_107   { comment "camera 107: WireGuard underlay" }
    counter in_oth_107  { comment "camera 107: anything else at the NVR" }
    counter in_ntp_108  { comment "camera 108: NTP from 117.111.108.2" }
    counter in_wg_108   { comment "camera 108: WireGuard underlay" }
    counter in_oth_108  { comment "camera 108: anything else at the NVR" }
    counter in_ntp_109  { comment "camera 109: NTP from 117.111.109.2" }
    counter in_wg_109   { comment "camera 109: WireGuard underlay" }
    counter in_oth_109  { comment "camera 109: anything else at the NVR" }
    counter in_ntp_110  { comment "camera 110: NTP from 117.111.110.2" }
    counter in_wg_110   { comment "camera 110: WireGuard underlay" }
    counter in_oth_110  { comment "camera 110: anything else at the NVR" }
    counter in_ntp_111  { comment "camera 111: NTP from 117.111.111.2" }
    counter in_wg_111   { comment "camera 111: WireGuard underlay" }
    counter in_oth_111  { comment "camera 111: anything else at the NVR" }
    counter in_ntp_112  { comment "camera 112: NTP from 117.111.112.2" }
    counter in_wg_112   { comment "camera 112: WireGuard underlay" }
    counter in_oth_112  { comment "camera 112: anything else at the NVR" }
    counter in_admin_mgmt         { comment "admin host -> 22/8971 on the LAN side" }
    counter in_ntp_lan            { comment "a LAN host still trying to take time from us: now denied" }
    counter in_mgmt_offlan        { comment "22/8971 from somewhere that is NOT the LAN side" }

    chain observe_forward {
        # priority filter - 10: BEFORE every other filter hook, which is
        # the opposite of what this said until 2026-10-22. It used to be
        # `filter + 10`, "so this observes what survives them rather
        # than what was offered" — and that was precisely wrong for an
        # instrument whose whole job is to measure what the existing
        # rules would deny.
        #
        # `inet myfw` runs at priority 0 with `policy drop` on input and
        # output, so anything it dropped never reached these chains at
        # all. Two consequences, both real:
        #
        #   - `out_wg_1NN` was built to reveal "the NVR is initiating a
        #     WireGuard handshake and being stopped by its own egress
        #     filter". At +10 it could never have shown that: the drop
        #     happened first, so the counter would have read zero for
        #     exactly the fault it existed to detect.
        #   - `in_oth_1NN` reading zero across the 24h window meant only
        #     "no camera used a port myfw already permitted". Anything
        #     else was dropped at priority 0 and never counted, so the
        #     finding was weaker than it was stated to be.
        #
        # At -10 these chains see every packet as offered, whatever any
        # other table later does with it. Conntrack runs at -200, so
        # `ct state` is still available here.
        type filter hook forward priority filter - 10; policy accept;

        # Already-established flows are not candidates for a NEW-state
        # drop, so they must not be counted as casualties.
        ct state established,related return

        # ---- classes P2 will ALLOW. Counted nowhere; returned early so
        #      they cannot fall through into fwd_other and inflate it.
        ct status dnat return
        ip saddr 172.19.0.2 ip daddr 117.111.0.0/16 tcp dport 554 return
        oifname "wg0" ip daddr 10.77.0.0/24 tcp dport 554 return
        ip saddr 88.255.1.221 oifname "enp6s0.*" tcp dport { 22, 443 } return

        # Ping into a camera VLAN from the LAN. ADDED 2026-10-22: the
        # window caught exactly one packet of it — the operator pinging
        # camera 3 while it rebooted for its MAC change — and P2 as
        # drafted would have dropped it. "Can I ping the camera" is the
        # first thing anyone asks when one does not come back, and
        # losing it looks precisely like the lockdown broke something.
        #
        # Scoped to the LAN per the operator: echo REQUEST only, arriving
        # on the LAN interface, from LAN space. The interface match is
        # what makes "from the LAN" true; the saddr match is belt-and-
        # braces while `rp_filter` is still 0 (P4 fixes that), since
        # without it nothing stops a forged LAN source from elsewhere.
        # Replies ride the established rule above.
        iifname "enp4s0" ip saddr 88.255.0.0/16 oifname "enp6s0.*" \
            icmp type echo-request return

        # ---- classes P2 will DROP. Count, log sparsely, then RETURN.
        iifname "wg0" oifname "wg0" limit rate 6/minute log prefix "gsfw-wouldblock wg-to-wg: " level info
        iifname "wg0" oifname "wg0" counter name fwd_wg_to_wg return
        iifname "wg0" limit rate 6/minute log prefix "gsfw-wouldblock wg-initiated: " level info
        iifname "wg0" counter name fwd_wg_initiated return

        # Anything pulling RTSP from a camera that is not Frigate. The
        # operator asked for this one specifically, by pre-NAT source.
        ip daddr 117.111.0.0/16 tcp dport 554 limit rate 12/minute log prefix "gsfw-wouldblock rtsp-not-frigate: " level warn
        ip daddr 117.111.0.0/16 tcp dport 554 counter name fwd_rtsp_nonfrigate return

        # A camera VLAN talking out to anything. With forward policy
        # ACCEPT today, this reaches every camera, the LAN, and the
        # internet. This counter being non-zero is the finding.
        iifname "enp6s0.*" limit rate 12/minute log prefix "gsfw-wouldblock cam-egress: " level warn
        iifname "enp6s0.*" counter name fwd_cam_egress return

        oifname "enp6s0.*" limit rate 12/minute log prefix "gsfw-wouldblock into-cam: " level info
        oifname "enp6s0.*" counter name fwd_into_cam_other return

        limit rate 6/minute log prefix "gsfw-wouldblock other-forward: " level info
        counter name fwd_other return
    }

    chain observe_input {
        type filter hook input priority filter - 10; policy accept;
        ct state established,related return
        iif "lo" return

        # NTP from a camera: P3 KEEPS this. Counted to prove it is in use
        # before P3 narrows the input chain, and to catch camera 12 if it
        # starts asking while chrony still refuses it.
        iifname "enp6s0.101" ip saddr 117.111.101.2 udp dport 123 counter name in_ntp_101 return
        iifname "enp6s0.101" ip saddr 117.111.101.2 udp dport 51820 counter name in_wg_101 return
        iifname "enp6s0.102" ip saddr 117.111.102.2 udp dport 123 counter name in_ntp_102 return
        iifname "enp6s0.102" ip saddr 117.111.102.2 udp dport 51820 counter name in_wg_102 return
        iifname "enp6s0.103" ip saddr 117.111.103.2 udp dport 123 counter name in_ntp_103 return
        iifname "enp6s0.103" ip saddr 117.111.103.2 udp dport 51820 counter name in_wg_103 return
        iifname "enp6s0.104" ip saddr 117.111.104.2 udp dport 123 counter name in_ntp_104 return
        iifname "enp6s0.104" ip saddr 117.111.104.2 udp dport 51820 counter name in_wg_104 return
        iifname "enp6s0.105" ip saddr 117.111.105.2 udp dport 123 counter name in_ntp_105 return
        iifname "enp6s0.105" ip saddr 117.111.105.2 udp dport 51820 counter name in_wg_105 return
        iifname "enp6s0.106" ip saddr 117.111.106.2 udp dport 123 counter name in_ntp_106 return
        iifname "enp6s0.106" ip saddr 117.111.106.2 udp dport 51820 counter name in_wg_106 return
        iifname "enp6s0.107" ip saddr 117.111.107.2 udp dport 123 counter name in_ntp_107 return
        iifname "enp6s0.107" ip saddr 117.111.107.2 udp dport 51820 counter name in_wg_107 return
        iifname "enp6s0.108" ip saddr 117.111.108.2 udp dport 123 counter name in_ntp_108 return
        iifname "enp6s0.108" ip saddr 117.111.108.2 udp dport 51820 counter name in_wg_108 return
        iifname "enp6s0.109" ip saddr 117.111.109.2 udp dport 123 counter name in_ntp_109 return
        iifname "enp6s0.109" ip saddr 117.111.109.2 udp dport 51820 counter name in_wg_109 return
        iifname "enp6s0.110" ip saddr 117.111.110.2 udp dport 123 counter name in_ntp_110 return
        iifname "enp6s0.110" ip saddr 117.111.110.2 udp dport 51820 counter name in_wg_110 return
        iifname "enp6s0.111" ip saddr 117.111.111.2 udp dport 123 counter name in_ntp_111 return
        iifname "enp6s0.111" ip saddr 117.111.111.2 udp dport 51820 counter name in_wg_111 return
        iifname "enp6s0.112" ip saddr 117.111.112.2 udp dport 123 counter name in_ntp_112 return
        iifname "enp6s0.112" ip saddr 117.111.112.2 udp dport 51820 counter name in_wg_112 return
        iifname "enp6s0.*" ip protocol icmp return

        # Anything else a camera sends AT the NVR. P3 drops this, so a
        # non-zero counter here is a service something depends on that
        # nobody mentioned.
        iifname "enp6s0.101" limit rate 6/minute log prefix "gsfw-wouldblock cam-to-nvr c101: " level warn
        iifname "enp6s0.101" counter name in_oth_101 return
        iifname "enp6s0.102" limit rate 6/minute log prefix "gsfw-wouldblock cam-to-nvr c102: " level warn
        iifname "enp6s0.102" counter name in_oth_102 return
        iifname "enp6s0.103" limit rate 6/minute log prefix "gsfw-wouldblock cam-to-nvr c103: " level warn
        iifname "enp6s0.103" counter name in_oth_103 return
        iifname "enp6s0.104" limit rate 6/minute log prefix "gsfw-wouldblock cam-to-nvr c104: " level warn
        iifname "enp6s0.104" counter name in_oth_104 return
        iifname "enp6s0.105" limit rate 6/minute log prefix "gsfw-wouldblock cam-to-nvr c105: " level warn
        iifname "enp6s0.105" counter name in_oth_105 return
        iifname "enp6s0.106" limit rate 6/minute log prefix "gsfw-wouldblock cam-to-nvr c106: " level warn
        iifname "enp6s0.106" counter name in_oth_106 return
        iifname "enp6s0.107" limit rate 6/minute log prefix "gsfw-wouldblock cam-to-nvr c107: " level warn
        iifname "enp6s0.107" counter name in_oth_107 return
        iifname "enp6s0.108" limit rate 6/minute log prefix "gsfw-wouldblock cam-to-nvr c108: " level warn
        iifname "enp6s0.108" counter name in_oth_108 return
        iifname "enp6s0.109" limit rate 6/minute log prefix "gsfw-wouldblock cam-to-nvr c109: " level warn
        iifname "enp6s0.109" counter name in_oth_109 return
        iifname "enp6s0.110" limit rate 6/minute log prefix "gsfw-wouldblock cam-to-nvr c110: " level warn
        iifname "enp6s0.110" counter name in_oth_110 return
        iifname "enp6s0.111" limit rate 6/minute log prefix "gsfw-wouldblock cam-to-nvr c111: " level warn
        iifname "enp6s0.111" counter name in_oth_111 return
        iifname "enp6s0.112" limit rate 6/minute log prefix "gsfw-wouldblock cam-to-nvr c112: " level warn
        iifname "enp6s0.112" counter name in_oth_112 return

        # NTP from the LAN side, which P3 now DENIES: the operator
        # confirmed that only devices behind this server take time from
        # it and nothing on the LAN does.
        #
        # The counter stays, and it only became useful once these chains
        # moved ahead of `inet myfw`. It now counts ATTEMPTS that myfw
        # drops — so if some LAN host was quietly relying on this NVR
        # for time, it shows up here as a number instead of as a clock
        # drifting somewhere nobody is looking.
        iifname "enp4s0" udp dport 123 counter name in_ntp_lan return

        # Management, and management from the wrong side of the house.
        iifname "enp4s0" ip saddr 88.255.1.221 tcp dport { 22, 8971 } \
            counter name in_admin_mgmt return
        tcp dport { 22, 8971 } limit rate 12/minute log prefix "gsfw-wouldblock mgmt-not-lan: " level warn
        tcp dport { 22, 8971 } counter name in_mgmt_offlan return
    }

    # ---- what the NVR ORIGINATES toward a camera ----------------------
    counter out_wg_101        { comment "NVR -> camera 101 udp/51820: tunnel handshake we ORIGINATE" }
    counter out_wg_102        { comment "NVR -> camera 102 udp/51820: tunnel handshake we ORIGINATE" }
    counter out_wg_103        { comment "NVR -> camera 103 udp/51820: tunnel handshake we ORIGINATE" }
    counter out_wg_104        { comment "NVR -> camera 104 udp/51820: tunnel handshake we ORIGINATE" }
    counter out_wg_105        { comment "NVR -> camera 105 udp/51820: tunnel handshake we ORIGINATE" }
    counter out_wg_106        { comment "NVR -> camera 106 udp/51820: tunnel handshake we ORIGINATE" }
    counter out_wg_107        { comment "NVR -> camera 107 udp/51820: tunnel handshake we ORIGINATE" }
    counter out_wg_108        { comment "NVR -> camera 108 udp/51820: tunnel handshake we ORIGINATE" }
    counter out_wg_109        { comment "NVR -> camera 109 udp/51820: tunnel handshake we ORIGINATE" }
    counter out_wg_110        { comment "NVR -> camera 110 udp/51820: tunnel handshake we ORIGINATE" }
    counter out_wg_111        { comment "NVR -> camera 111 udp/51820: tunnel handshake we ORIGINATE" }
    counter out_wg_112        { comment "NVR -> camera 112 udp/51820: tunnel handshake we ORIGINATE" }

    chain observe_output {
        # Pure measurement, no verdicts, like the rest of this table.
        # It exists for one failure that is otherwise invisible: the
        # cameras LISTEN on udp/51820 and WireGuard lets EITHER side
        # start a handshake, so when Frigate reconnects RTSP across a
        # lapsed session the NVR initiates. `inet myfw`'s output chain
        # is `policy drop` and does not permit udp/51820, so that
        # handshake dies in our own egress filter with no log and no
        # counter, and presents as a key or camera fault.
        #
        # This chain cannot fix that — an accept here would not save a
        # packet from another chain's drop policy, which is why the
        # permitting rule has to live in `inet myfw` itself. What it
        # does is make the attempt VISIBLE: if `out_wg_1NN` moves while
        # `in_wg_1NN` on the camera side stays flat, the NVR is trying
        # to initiate and being stopped locally. That turns a silent
        # loss into a reading.
        type filter hook output priority filter - 10; policy accept;
        ct state established,related return
        oif "lo" return

        oifname "enp6s0.101" ip daddr 117.111.101.2 udp sport 51820 udp dport 51820 \
            counter name out_wg_101 return
        oifname "enp6s0.102" ip daddr 117.111.102.2 udp sport 51820 udp dport 51820 \
            counter name out_wg_102 return
        oifname "enp6s0.103" ip daddr 117.111.103.2 udp sport 51820 udp dport 51820 \
            counter name out_wg_103 return
        oifname "enp6s0.104" ip daddr 117.111.104.2 udp sport 51820 udp dport 51820 \
            counter name out_wg_104 return
        oifname "enp6s0.105" ip daddr 117.111.105.2 udp sport 51820 udp dport 51820 \
            counter name out_wg_105 return
        oifname "enp6s0.106" ip daddr 117.111.106.2 udp sport 51820 udp dport 51820 \
            counter name out_wg_106 return
        oifname "enp6s0.107" ip daddr 117.111.107.2 udp sport 51820 udp dport 51820 \
            counter name out_wg_107 return
        oifname "enp6s0.108" ip daddr 117.111.108.2 udp sport 51820 udp dport 51820 \
            counter name out_wg_108 return
        oifname "enp6s0.109" ip daddr 117.111.109.2 udp sport 51820 udp dport 51820 \
            counter name out_wg_109 return
        oifname "enp6s0.110" ip daddr 117.111.110.2 udp sport 51820 udp dport 51820 \
            counter name out_wg_110 return
        oifname "enp6s0.111" ip daddr 117.111.111.2 udp sport 51820 udp dport 51820 \
            counter name out_wg_111 return
        oifname "enp6s0.112" ip daddr 117.111.112.2 udp sport 51820 udp dport 51820 \
            counter name out_wg_112 return
    }
}
