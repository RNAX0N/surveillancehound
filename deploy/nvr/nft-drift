#!/usr/bin/python3
"""nft-drift — does the LIVE ruleset match what the config file says?

The problem this exists for: a firewall has two states that can silently
disagree. A rule added live and never written to the config is lost at
the next reload, reboot or `docker restart`. A rule written to the config
but never applied means you believe you are protected and are not. Both
are silent, and the second one is already true on this host — the
hardening keys in /etc/sysctl.conf were never applied, which is why
rp_filter reads 0.

Neither `nft -c -f` nor `nft list ruleset` can tell you about either:
the first says the file parses, the second says what is loaded. Nobody
compares them.

So: render the config in a THROWAWAY NETWORK NAMESPACE, which has its
own empty nftables, and diff it against live. The namespace means the
render is free of consequences — no flush, no reload, nothing touched.
Only tables the config itself defines are compared, so Docker's
iptables-nft tables are ignored rather than reported as drift forever.

    nft-drift [config]        exit 0 = in sync, 1 = drift, 2 = error

Stdlib only, no daemon, safe to run from cron or a systemd timer.
"""
from __future__ import annotations

import collections
import os
import re
import subprocess
import sys

CONF = sys.argv[1] if len(sys.argv) > 1 else "/etc/nftables.conf"
NS = f"nftdrift{os.getpid()}"

# Counters differ by construction (the namespace render has never seen a
# packet) and handles are allocation order. Neither is drift.
#
# Two shapes, and missing the second one made this tool useless: an
# inline rule counter reads `counter packets N bytes M`, but a NAMED
# counter object puts its totals on their own line inside the braces.
# The observe table is 44 named counters, so every drift report was a
# wall of packet totals and a real change would have been lost in it. A
# check that cries wolf on every incremented counter does not get read.
_NOISE = (
    (re.compile(r"counter packets \d+ bytes \d+"), "counter"),
    (re.compile(r"^(\s*)packets \d+ bytes \d+\s*$"), r"\1packets N bytes N"),
    (re.compile(r" # handle \d+"), ""),
    (re.compile(r"[ \t]+$"), ""),
)


_ELEMENTS = re.compile(r"elements\s*=\s*\{(?P<body>[^}]*)\}")


def _self_expiring(line: str) -> bool:
    """True only if this is a set-element line and EVERY element in it
    carries an expiry.

    The "every" matters. One permanent element hiding among expiring
    ones is exactly how on-demand access becomes permanent access, so
    a mixed list is still reported as drift.
    """
    m = _ELEMENTS.search(line)
    if not m:
        return False
    parts = [e.strip() for e in m.group("body").split(",") if e.strip()]
    return bool(parts) and all(" expires " in f" {e} " or "expires" in e
                               for e in parts)


def sh(*argv: str) -> tuple[int, str]:
    p = subprocess.run(argv, capture_output=True, text=True)
    return p.returncode, (p.stdout or "") + (p.stderr or "")


_ELEM_BLOCK = re.compile(r"elements\s*=\s*\{(.*?)\}", re.S)


def _collapse_elements(text: str) -> str:
    """Put a multi-element set list back on one line.

    nft wraps `elements = { a, b }` across lines once there is more than
    one element, which split the block so neither half looked like a set
    at all. The halves then read as two unexplained live-only lines, so
    the moment a SECOND on-demand client was authorised every
    legitimate use would report drift again — the cry-wolf failure this
    check keeps walking into.
    """
    return _ELEM_BLOCK.sub(
        lambda m: "elements = {" + " ".join(m.group(1).split()) + "}", text)


def normalise(text: str) -> list[str]:
    out = []
    for line in _collapse_elements(text).splitlines():
        for rx, repl in _NOISE:
            line = rx.sub(repl, line)
        if line.strip():
            out.append(line.rstrip())
    return out


def main() -> int:
    if os.geteuid() != 0:
        print("nft-drift: must run as root", file=sys.stderr)
        return 2
    if not os.path.isfile(CONF):
        print(f"nft-drift: no such config: {CONF}", file=sys.stderr)
        return 2

    rc, _ = sh("ip", "netns", "add", NS)
    if rc != 0:
        print(f"nft-drift: could not create namespace {NS}", file=sys.stderr)
        return 2
    try:
        rc, err = sh("ip", "netns", "exec", NS, "nft", "-f", CONF)
        if rc != 0:
            # The config does not even load cleanly into an empty ruleset.
            # That is worse than drift and must not be reported as "in sync".
            print("DRIFT: the config does not apply to an empty ruleset:")
            print("  " + err.strip().replace("\n", "\n  "))
            return 1

        rc, tables = sh("ip", "netns", "exec", NS, "nft", "list", "tables")
        wanted = [ln.split() for ln in tables.splitlines() if ln.startswith("table ")]

        problems = []
        notes = []
        for _, family, name in wanted:
            rc_ns, want = sh("ip", "netns", "exec", NS,
                             "nft", "list", "table", family, name)
            rc_live, live = sh("nft", "list", "table", family, name)
            if rc_live != 0:
                problems.append(
                    f"  table {family} {name}: in the config, NOT LOADED. "
                    f"Anything it protects is unprotected right now.")
                continue
            a, b = normalise(want), normalise(live)
            if a == b:
                continue
            # Multiset, not membership: `x not in b` hides a line that
            # exists once in the config and three times live, which is
            # precisely what a duplicated rule looks like.
            only_cfg = list((collections.Counter(a)
                             - collections.Counter(b)).elements())
            only_live = list((collections.Counter(b)
                              - collections.Counter(a)).elements())

            # Elements that carry their own expiry are transient BY
            # DESIGN — the on-demand camera web access set is the live
            # example. They are genuinely live-only and genuinely lost
            # on reload, which is the intended behaviour, not a finding.
            # Reporting them as drift would mean every legitimate use of
            # `startcamaccess` raised an alert, and an alert that fires
            # on correct operation is one the operator learns to skip.
            # They are still PRINTED, because unexplained access is
            # worth seeing; they just do not fail the check.
            transient = [x for x in only_live if _self_expiring(x)]
            only_live = [x for x in only_live if not _self_expiring(x)]
            for x in transient:
                notes.append(f"  table {family} {name}: on-demand, "
                             f"self-expiring: {x.strip()}")
            if not only_cfg and not only_live:
                continue

            problems.append(f"  table {family} {name}:")
            for x in only_cfg:
                problems.append(f"    in config, not live : {x.strip()}")
            for x in only_live:
                problems.append(
                    f"    LIVE ONLY, will be LOST on reload/reboot: {x.strip()}")

        if problems:
            print("DRIFT between /etc/nftables.conf and the live ruleset:")
            print("\n".join(problems))
            print("\nA live-only rule disappears at the next reload, reboot or")
            print("`docker restart`. A config-only rule is not protecting you.")
            if notes:
                print("\nAlso live, but expected:")
                print("\n".join(notes))
            return 1

        names = ", ".join(f"{f} {n}" for _, f, n in wanted) or "(none)"
        print(f"in sync: {len(wanted)} table(s) match the config [{names}]")
        if notes:
            print("Open on demand right now, and self-expiring:")
            print("\n".join(notes))
        return 0
    finally:
        sh("ip", "netns", "del", NS)


if __name__ == "__main__":
    sys.exit(main())
